## Example Usage

```terraform
# Read SSH configuration for a specific host
data "sshconfig_host" "example" {
  host = "example.com"
  path = "/etc/ssh/ssh_config"
}

# Use the configuration data
output "ssh_hostname" {
  description = "The hostname for SSH connection"
  value       = data.sshconfig_host.example.host_map["HostName"]
}

output "ssh_user" {
  description = "The user for SSH connection"
  value       = data.sshconfig_host.example.host_map["User"]
}

output "ssh_port" {
  description = "The port for SSH connection"
  value       = lookup(data.sshconfig_host.example.host_map, "Port", "22")
}

# Access the full rendered configuration
output "full_config" {
  value = data.sshconfig_host.example.rendered
}
```

## Example SSH Config File

```
Host example.com
    HostName 192.168.1.100
    User myuser
    Port 2222
    IdentityFile ~/.ssh/id_rsa
    ForwardAgent yes

Host *.development
    User admin
    ProxyJump bastion.example.com
    IdentityFile ~/.ssh/dev_key

Host bastion.example.com
    HostName 10.0.1.5
    User ubuntu
    IdentityFile ~/.ssh/bastion_key
```

